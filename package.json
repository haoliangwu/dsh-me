{
  "name": "dsh-me",
  "version": "0.1.0",
  "description": "Personal DSH plugin bundle: one install for haoliangwu's plugins (peak-rate 🔥 2× composer badge first)",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./plugins/peak-rate": "./lib/plugins/peak-rate.js",
    "./plugins/peak-rate/invariant": "./lib/plugins/peak-rate/invariant.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "license": "MIT",
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "devDependencies": {
    "tsdown": "^0.12.0",
    "lightningcss": "^1.29.0",
    "typescript": "^5.7.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2"
  }
}
